---
import ThemeIcon from './ThemeIcon.astro';
---
<div class="flex items-center justify-between w-full py-4 max-w-5xl mx-auto">
    <div class="font-bold text-xl tracking-tighter">
        <a href="/" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">@mrohith29</a>
    </div>
    <div class="flex items-center gap-6 font-medium text-sm sm:text-base">
        <a href="/works/" class="hover:text-amber-500 transition-colors relative group">
            Works
            <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-amber-500 transition-all group-hover:w-full"></span>
        </a>
        <a href="/blog/" class="hover:text-amber-500 transition-colors relative group">
            Blog
            <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-amber-500 transition-all group-hover:w-full"></span>
        </a>
        <a href="https://github.com/mrohith29/portfolio" target="_blank" class="hover:text-amber-500 transition-colors hidden sm:inline-block">GitHub</a>
        <ThemeIcon />
    </div>
</div>
