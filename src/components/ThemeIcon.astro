---
<button
  id="themeToggle"
  type="button"
  class="theme-toggle"
  aria-label="Toggle color theme"
  title="Toggle theme"
>
  <span class="ti-dark" aria-hidden="true">◐ dark</span>
  <span class="ti-light" aria-hidden="true">◑ light</span>
</button>

<style>
  .theme-toggle {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 0.25rem 0.55rem;
    background: transparent;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .theme-toggle:hover { color: var(--accent); border-color: var(--accent); }
  .ti-dark { display: none; }
  .ti-light { display: inline; }
  :global(.dark) .ti-dark { display: inline; }
  :global(.dark) .ti-light { display: none; }
</style>

<script is:inline>
  const handleToggleClick = () => {
    const el = document.documentElement;
    el.classList.toggle("dark");
    localStorage.setItem("theme", el.classList.contains("dark") ? "dark" : "light");
  };
  const setupThemeToggle = () => {
    const t = document.getElementById("themeToggle");
    if (t) t.onclick = handleToggleClick;
  };
  setupThemeToggle();
  document.addEventListener("astro:page-load", setupThemeToggle);
</script>
