---
import Layout from "../layouts/Layout.astro";
const pageTitle = "404 — command not found";
---
<Layout pageTitle={pageTitle}>
  <section class="container-t nf">
    <p class="prompt"><span class="user">rohith@prod</span>:<span class="path">~</span>$ <span class="cmd">cd {Astro.url.pathname}</span></p>
    <h1 class="nf-code">404<span class="cursor" aria-hidden="true"></span></h1>
    <p class="nf-msg">bash: no such file or directory — you've wandered off the path.</p>
    <div class="nf-actions">
      <a href="/" class="btn btn-primary">cd ~ (home)</a>
      <a href="/works/" class="btn btn-ghost">view work</a>
    </div>
  </section>
</Layout>

<style>
  .nf { padding-block: 4rem 3rem; max-width: 640px; }
  .nf-code { font-size: clamp(3.5rem, 14vw, 7rem); color: var(--accent); text-shadow: var(--glow); margin: 1rem 0 0.5rem; }
  .nf-msg { color: var(--fg-soft); margin-bottom: 2rem; }
  .nf-actions { display: flex; flex-wrap: wrap; gap: 0.7rem; }
</style>
