---
import Layout from "../layouts/Layout.astro";
const pageTitle = "404 Not Found";
---

<Layout pageTitle={pageTitle}>
    <div class="flex flex-col items-center justify-center min-h-[60vh] text-center px-4">
        <div class="mb-8">
            <img width="300" height="259" alt="Raccoon 404" src="/404.webp" class="rounded-xl shadow-lg" />
        </div>
        <h1 class="text-6xl font-bold text-zinc-900 dark:text-white mb-4">404</h1>
        <p class="text-xl text-zinc-600 dark:text-zinc-400 mb-8">
            It seems like you've wandered into the wrong city!
        </p>
        <a class="px-6 py-3 rounded-full bg-indigo-600 text-white font-medium hover:bg-indigo-700 transition-colors shadow-lg hover:shadow-xl" href="/">
            Return Home
        </a>
    </div>
</Layout>
