---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const pageTitle = "Writing — Rohith Mariyala";

const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { day: "2-digit", month: "short", year: "numeric" });
---
<Layout pageTitle={pageTitle}>
  <section class="container-t">
    <header class="page-head">
      <p class="prompt"><span class="user">rohith@prod</span>:<span class="path">~</span>$ <span class="cmd">ls ./writing -t</span></p>
      <h1 class="page-title">Writing</h1>
      <p class="page-intro">
        Notes on backend systems, agentic AI, and things I figure out while building.
        Newest first.
      </p>
    </header>

    <div class="posts">
      {posts.map((post) => (
        <a href={`/blog/${post.id}/`} class="post">
          <div class="post-top">
            <time class="post-date" datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
            {post.data.tags.length > 0 && (
              <span class="post-tags">{post.data.tags.map((t) => `#${t}`).join(" ")}</span>
            )}
          </div>
          <h2 class="post-title">{post.data.title}</h2>
          <p class="post-desc">{post.data.description}</p>
          <span class="post-read">read →</span>
        </a>
      ))}
    </div>

    {posts.length === 0 && <p class="empty">No posts yet — check back soon.</p>}
  </section>
</Layout>

<style>
  .page-head { margin-bottom: 2.4rem; }
  .page-title { font-size: clamp(2rem, 6vw, 3rem); color: var(--fg); margin: 0.9rem 0 0.7rem; }
  .page-intro { color: var(--fg-soft); max-width: 60ch; }

  .posts { display: flex; flex-direction: column; }
  .post {
    display: block;
    padding: 1.5rem 0;
    border-top: 1px solid var(--line);
    transition: padding-left 0.18s ease;
  }
  .post:last-child { border-bottom: 1px solid var(--line); }
  .post:hover { padding-left: 0.6rem; }
  .post:hover .post-title { color: var(--accent); }
  .post:hover .post-read { color: var(--accent); }
  .post-top { display: flex; align-items: center; gap: 1rem; margin-bottom: 0.5rem; flex-wrap: wrap; }
  .post-date { font-size: 0.76rem; color: var(--muted); font-variant-numeric: tabular-nums; }
  .post-tags { font-size: 0.74rem; color: var(--muted); }
  .post-title { font-size: 1.3rem; color: var(--fg); transition: color 0.18s ease; }
  .post-desc { color: var(--fg-soft); max-width: 66ch; margin: 0.4rem 0 0.7rem; }
  /* No opacity dimming — it dropped --muted below the 4.5:1 it's tuned for */
  .post-read { font-size: 0.8rem; color: var(--muted); transition: color 0.18s ease; }
  .empty { color: var(--muted); padding: 2rem 0; }
</style>
