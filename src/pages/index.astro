---
import Layout from "../layouts/Layout.astro";
import FeaturedWork from "../components/FeaturedWork.astro";
import { getCollection } from "astro:content";

const pageTitle = "Rohith Mariyala — Backend & Agentic-AI Engineer";

const projects = await getCollection("projects");
const featured = projects
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const experience = (await getCollection("experience")).sort((a, b) =>
  b.data.start.localeCompare(a.data.start)
);
const current = experience.find((e) => e.data.current) ?? experience[0];

const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const fmtMonth = (s: string) =>
  new Date(s + "-01").toLocaleDateString("en-US", { month: "short", year: "numeric" });

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Rohith Mariyala",
  url: "https://rohithmariyala.com",
  email: "mailto:mariyalarohith29@gmail.com",
  jobTitle: "Backend & Agentic-AI Engineer",
  worksFor: { "@type": "Organization", name: "Techolution" },
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "Gokaraju Rangaraju Institute of Engineering and Technology",
  },
  knowsAbout: [
    "Backend Engineering",
    "Workflow Orchestration",
    "Temporal",
    "Event-Driven Architecture",
    "Distributed Systems",
    "Agentic AI",
    "FastAPI",
    "Cloud Computing",
  ],
  sameAs: [
    "https://github.com/mrohith29",
    "https://www.linkedin.com/in/mariyala-rohith/",
  ],
};
---
<Layout pageTitle={pageTitle}>
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} slot="head" />

  <!-- ============ HERO ============ -->
  <section class="hero container-t">
    <div class="hero-main">
      <p class="prompt hero-prompt">
        <span class="user">rohith@prod</span>:<span class="path">~</span>$ <span class="cmd">whoami --full</span>
      </p>

      <h1 class="hero-name">Rohith Mariyala<span class="cursor" aria-hidden="true"></span></h1>

      <p class="hero-role">Backend &amp; Agentic-AI Engineer</p>

      <span class="status amber hero-status">
        <span class="live"></span> Associate Backend Developer @ Techolution
      </span>

      <p class="hero-manifesto">
        I don't collect tools to look employable. I pick up whatever a real problem
        needs — a new language, a new stack, a new idea — and go deep enough to ship it.
        <span class="hm-strong">The work below is the proof.</span>
      </p>

      <div class="hero-cta">
        <a href="/works/" class="btn btn-primary">view work →</a>
        <a href="#contact" class="btn btn-ghost">get in touch</a>
      </div>
    </div>

    <aside class="hero-readout panel" aria-label="Quick facts">
      <div class="panel-bar">
        <span class="dot"></span><span class="dot"></span><span class="dot"></span>
        <span class="ttl">cat ./status.json</span>
      </div>
      <div class="readout-body">
        <div class="kv"><span class="k">role</span><span class="v">Associate Backend Dev</span></div>
        <div class="kv"><span class="k">at</span><span class="v amber">Techolution</span></div>
        <div class="kv"><span class="k">focus</span><span class="v">scaling + orchestration</span></div>
        <div class="kv"><span class="k">based</span><span class="v">Hyderabad, IN</span></div>
        <div class="kv"><span class="k">status</span><span class="v ok">open to opportunities</span></div>
      </div>
    </aside>
  </section>

  <!-- ============ SELECTED WORK ============ -->
  <section class="block container-t">
    <div class="block-head">
      <p class="prompt"><span class="user">rohith@prod</span>:<span class="path">~</span>$ <span class="cmd">ls ./work --featured</span></p>
      <a href="/works/" class="block-more">all work →</a>
    </div>
    <div class="work-grid">
      {featured.map((p) => (
        <FeaturedWork
          slug={p.slug}
          title={p.data.title}
          description={p.data.description}
          problem={p.data.problem}
          outcome={p.data.outcome}
          tech={p.data.tech}
          year={p.data.year}
          github={p.data.github}
          website={p.data.website}
        />
      ))}
    </div>
  </section>

  <!-- ============ CURRENTLY (experience preview) ============ -->
  {current && (
    <section class="block container-t">
      <div class="block-head">
        <p class="prompt"><span class="user">rohith@prod</span>:<span class="path">~</span>$ <span class="cmd">cat ./experience --head 1</span></p>
        <a href="/experience/" class="block-more">full history →</a>
      </div>
      <a href="/experience/" class="cur-card panel">
        <div class="cur-body">
          <div class="cur-top">
            <span class="cur-role">{current.data.role}</span>
            <span class="status amber"><span class="live"></span> now</span>
          </div>
          <div class="cur-company">{current.data.company} · {current.data.location}</div>
          <p class="cur-summary">{current.data.summary}</p>
          <div class="cur-time">{fmtMonth(current.data.start)} → present</div>
        </div>
      </a>
    </section>
  )}

  <!-- ============ WRITING ============ -->
  {posts.length > 0 && (
    <section class="block container-t">
      <div class="block-head">
        <p class="prompt"><span class="user">rohith@prod</span>:<span class="path">~</span>$ <span class="cmd">tail ./writing</span></p>
        <a href="/blog/" class="block-more">all posts →</a>
      </div>
      <div class="post-list">
        {posts.map((post) => (
          <a href={`/blog/${post.slug}/`} class="post-row">
            <span class="post-date">{post.data.pubDate.toLocaleDateString("en-US", { day: "2-digit", month: "short", year: "numeric" })}</span>
            <span class="post-title">{post.data.title}</span>
            <span class="post-arrow">→</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- ============ CONTACT ============ -->
  <section id="contact" class="block container-t contact" style="scroll-margin-top: 5rem;">
    <p class="prompt"><span class="user">rohith@prod</span>:<span class="path">~</span>$ <span class="cmd">./say-hi.sh</span></p>
    <h2 class="contact-h">Building something? Hiring? Just curious?</h2>
    <p class="contact-sub">The fastest way to reach me is email — I read everything.</p>
    <div class="hero-cta">
      <a href="mailto:mariyalarohith29@gmail.com" class="btn btn-primary">mariyalarohith29@gmail.com</a>
      <a href="https://www.linkedin.com/in/mariyala-rohith/" target="_blank" rel="noopener" class="btn btn-ghost">linkedin ↗</a>
      <a href="https://github.com/mrohith29" target="_blank" rel="noopener" class="btn btn-ghost">github ↗</a>
    </div>
  </section>
</Layout>

<style>
  /* Hero */
  .hero {
    display: grid;
    grid-template-columns: 1.5fr 0.9fr;
    gap: 2.5rem;
    align-items: start;
    padding-block: 1.5rem 3.5rem;
  }
  .hero-prompt { margin-bottom: 1.1rem; }
  .hero-name { font-size: clamp(2.2rem, 6vw, 3.6rem); font-weight: 800; color: var(--fg); }
  .hero-role { font-size: 1.05rem; color: var(--fg-soft); margin: 0.6rem 0 1rem; }
  .hero-status { margin-bottom: 1.5rem; }
  .hero-manifesto {
    color: var(--fg-soft);
    max-width: 54ch;
    line-height: 1.75;
    margin-bottom: 1.8rem;
  }
  .hm-strong { color: var(--fg); }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 0.7rem; }

  .hero-readout { position: sticky; top: 5rem; }
  .readout-body { padding: 0.9rem 1.1rem; font-size: 0.85rem; }

  /* Section blocks */
  .block { padding-block: 2.2rem; }
  .block-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.4rem;
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.9rem;
  }
  .block-more { font-size: 0.82rem; color: var(--muted); white-space: nowrap; }
  .block-more:hover { color: var(--accent); }

  .work-grid { display: grid; gap: 1.4rem; }

  /* Currently card */
  .cur-card { display: block; transition: border-color 0.2s ease; }
  .cur-card:hover { border-color: color-mix(in srgb, var(--accent) 45%, var(--line)); }
  .cur-body { padding: 1.3rem 1.4rem; }
  .cur-top { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 0.35rem; }
  .cur-role { font-size: 1.15rem; font-weight: 700; color: var(--fg); }
  .cur-company { color: var(--accent); font-size: 0.9rem; margin-bottom: 0.6rem; }
  .cur-summary { color: var(--fg-soft); max-width: 62ch; margin-bottom: 0.7rem; }
  .cur-time { font-size: 0.78rem; color: var(--muted); font-variant-numeric: tabular-nums; }

  /* Writing rows */
  .post-list { display: flex; flex-direction: column; }
  .post-row {
    display: grid;
    grid-template-columns: 8rem 1fr auto;
    gap: 1rem;
    align-items: baseline;
    padding: 0.9rem 0;
    border-top: 1px solid var(--line);
    transition: padding-left 0.18s ease;
  }
  .post-row:hover { padding-left: 0.5rem; }
  .post-row:hover .post-title { color: var(--accent); }
  .post-row:hover .post-arrow { color: var(--accent); }
  .post-date { font-size: 0.78rem; color: var(--muted); font-variant-numeric: tabular-nums; }
  .post-title { font-size: 1rem; color: var(--fg); transition: color 0.18s ease; }
  .post-arrow { color: var(--faint); transition: color 0.18s ease; }

  /* Contact */
  .contact { border-top: 1px solid var(--line); margin-top: 1rem; }
  .contact-h { font-size: clamp(1.4rem, 3.5vw, 2rem); color: var(--fg); margin: 1rem 0 0.5rem; }
  .contact-sub { color: var(--fg-soft); margin-bottom: 1.5rem; }

  @media (max-width: 820px) {
    .hero { grid-template-columns: 1fr; gap: 1.8rem; }
    .hero-readout { position: static; }
  }
  @media (max-width: 560px) {
    .post-row { grid-template-columns: 1fr auto; }
    .post-date { grid-column: 1 / -1; }
  }
</style>
