---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const pageTitle = "Experience — Rohith Mariyala";

const entries = (await getCollection("experience")).sort((a, b) =>
  b.data.start.localeCompare(a.data.start)
);
const roles = await Promise.all(
  entries.map(async (e) => ({ data: e.data, Content: (await e.render()).Content }))
);

const fmt = (s?: string) =>
  s ? new Date(s + "-01").toLocaleDateString("en-US", { month: "short", year: "numeric" }) : "Present";
---
<Layout pageTitle={pageTitle}>
  <section class="container-t">
    <header class="page-head">
      <p class="prompt"><span class="user">rohith@prod</span>:<span class="path">~</span>$ <span class="cmd">git log --oneline ./career</span></p>
      <h1 class="page-title">Experience</h1>
      <p class="page-intro">
        Where I've worked and what I built there — newest first.
      </p>
    </header>

    <ol class="timeline">
      {roles.map(({ data, Content }) => (
        <li class="tl-item">
          <div class="tl-marker">
            <span class:list={["tl-dot", { live: data.current }]}></span>
          </div>
          <div class="tl-content">
            <div class="tl-time">
              {fmt(data.start)} — {data.current ? <span class="now">present</span> : fmt(data.end)}
            </div>
            <h2 class="tl-role">{data.role}</h2>
            <div class="tl-company">
              {data.url ? (
                <a href={data.url} target="_blank" rel="noopener" class="link">{data.company} ↗</a>
              ) : (
                <span>{data.company}</span>
              )}
              <span class="tl-loc"> · {data.location}</span>
            </div>
            <p class="tl-summary">{data.summary}</p>
            <div class="prose-t tl-body">
              <Content />
            </div>
            {data.tech && data.tech.length > 0 && (
              <div class="tl-tech">
                {data.tech.map((t) => <span class="chip">{t}</span>)}
              </div>
            )}
          </div>
        </li>
      ))}
    </ol>

    <div class="tl-end">
      <a href="/#contact" class="btn btn-ghost">get in touch →</a>
    </div>
  </section>
</Layout>

<style>
  .page-head { margin-bottom: 2.6rem; }
  .page-title { font-size: clamp(2rem, 6vw, 3rem); color: var(--fg); margin: 0.9rem 0 0.7rem; }
  .page-intro { color: var(--fg-soft); max-width: 58ch; }

  .timeline { list-style: none; position: relative; padding-left: 0; }
  .tl-item { display: grid; grid-template-columns: 1.6rem 1fr; gap: 1.2rem; padding-bottom: 2.6rem; }
  .tl-marker { position: relative; }
  .tl-marker::before {
    content: "";
    position: absolute;
    left: 0.5rem;
    top: 1.4rem;
    bottom: -2.6rem;
    width: 1px;
    background: var(--line);
  }
  .tl-item:last-child .tl-marker::before { display: none; }
  .tl-dot {
    position: absolute;
    left: 0.15rem;
    top: 0.35rem;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--muted);
  }
  .tl-dot.live {
    border-color: var(--accent);
    background: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 18%, transparent), var(--glow);
  }
  .tl-time { font-size: 0.78rem; color: var(--muted); font-variant-numeric: tabular-nums; margin-bottom: 0.35rem; }
  .tl-time .now { color: var(--accent); }
  .tl-role { font-size: 1.3rem; color: var(--fg); }
  .tl-company { color: var(--accent); font-size: 0.92rem; margin: 0.25rem 0 0.8rem; }
  .tl-loc { color: var(--muted); }
  .tl-summary { color: var(--fg-soft); max-width: 62ch; margin-bottom: 0.9rem; }
  .tl-body { font-size: 0.92rem; }
  .tl-tech { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 1rem; }

  .tl-end { padding-top: 0.5rem; }

  @media (max-width: 560px) {
    .tl-item { grid-template-columns: 1.2rem 1fr; gap: 0.9rem; }
  }
</style>
