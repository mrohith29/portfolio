---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";

const allProjects = await getCollection("projects");
const pageTitle = "Works | Mariyala Rohith";
---

<Layout pageTitle={pageTitle}>
    <section class="py-12">
        <div class="text-center max-w-2xl mx-auto mb-16">
            <h1 class="text-4xl font-bold mb-4 text-zinc-900 dark:text-white">My Projects</h1>
            <p class="text-zinc-600 dark:text-zinc-400 text-lg">
                A collection of things I've built, from small experiments to full-stack applications.
            </p>
        </div>

        <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {
                allProjects.map((card) => (
                    <Card
                        url={`/projects/${card.slug}/`}
                        image={card.data.image.url}
                        title={card.data.title}
                        body={card.data.description}
                    />
                ))
            }
        </ul>
    </section>
</Layout>
