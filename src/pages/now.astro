---
import Layout from "../layouts/Layout.astro";

const pageTitle = "Now — Rohith Mariyala";
// Edit this page freely — it's meant to be a living snapshot of what you're up to.
const lastUpdated = "July 2026";

const now = [
  {
    k: "building",
    v: "High-concurrency backend + agent tooling for Techolution's proprietary agentic platform.",
  },
  {
    k: "learning",
    v: "Going deeper on AsyncIO internals, MCP servers, and squeezing latency out of Python services.",
  },
  {
    k: "studying",
    v: "Final year of B.Tech CSE at GRIET — wrapping up the degree while working.",
  },
  {
    k: "shipping",
    v: "MakeMeBetter AI — an end-to-end goals, habits & tasks tracker with a live AI (MCP) integration.",
  },
  {
    k: "open to",
    v: "Interesting backend & AI-engineering opportunities — always happy to talk.",
  },
];
---
<Layout pageTitle={pageTitle} description="What Rohith Mariyala is focused on right now.">
  <section class="container-t now-wrap">
    <header class="page-head">
      <p class="prompt"><span class="user">rohith@prod</span>:<span class="path">~</span>$ <span class="cmd">cat ./now.md</span></p>
      <h1 class="page-title">Now</h1>
      <p class="page-intro">
        A snapshot of what I'm focused on at the moment — inspired by
        <a href="https://nownownow.com/about" target="_blank" rel="noopener" class="link">nownownow.com</a>.
      </p>
    </header>

    <div class="now-list">
      {now.map((item) => (
        <div class="now-row">
          <span class="now-k">{item.k}</span>
          <span class="now-v">{item.v}</span>
        </div>
      ))}
    </div>

    <p class="now-updated">last updated — {lastUpdated}</p>
  </section>
</Layout>

<style>
  .page-head { margin-bottom: 2.4rem; }
  .page-title { font-size: clamp(2rem, 6vw, 3rem); color: var(--fg); margin: 0.9rem 0 0.7rem; }
  .page-intro { color: var(--fg-soft); max-width: 60ch; }

  .now-list { display: flex; flex-direction: column; }
  .now-row {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 1.2rem;
    padding: 1.1rem 0;
    border-top: 1px solid var(--line);
    align-items: baseline;
  }
  .now-row:last-child { border-bottom: 1px solid var(--line); }
  .now-k {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
  }
  .now-v { color: var(--fg-soft); max-width: 60ch; }
  .now-updated { margin-top: 1.5rem; font-size: 0.76rem; color: var(--muted); }

  @media (max-width: 520px) {
    .now-row { grid-template-columns: 1fr; gap: 0.3rem; }
  }
</style>
