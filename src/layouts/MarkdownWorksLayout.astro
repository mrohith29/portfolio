---
import Layout from "./Layout.astro";
const { frontmatter } = Astro.props;
---

<Layout pageTitle={frontmatter.title}>
    <article class="max-w-4xl mx-auto py-12">
        <div class="mb-8 text-center">
             <h1 class="text-3xl md:text-5xl font-bold mb-4 text-zinc-900 dark:text-white">{frontmatter.title}</h1>
        </div>

        <div class="flex flex-wrap justify-center gap-4 mb-12">
            <div class="flex flex-col items-center p-4 bg-zinc-50 dark:bg-zinc-800 rounded-xl min-w-[120px]">
                <span class="text-xs uppercase tracking-wider font-semibold text-zinc-500 dark:text-zinc-400 mb-1">Platform</span>
                <span class="font-medium text-zinc-900 dark:text-white">{frontmatter.platform}</span>
            </div>
            <div class="flex flex-col items-center p-4 bg-zinc-50 dark:bg-zinc-800 rounded-xl min-w-[120px]">
                <span class="text-xs uppercase tracking-wider font-semibold text-zinc-500 dark:text-zinc-400 mb-1">Stack</span>
                <span class="font-medium text-zinc-900 dark:text-white">{frontmatter.stack}</span>
            </div>
            <div class="flex flex-col items-center p-4 bg-zinc-50 dark:bg-zinc-800 rounded-xl min-w-[120px]">
                <span class="text-xs uppercase tracking-wider font-semibold text-zinc-500 dark:text-zinc-400 mb-1">Website</span>
                <a href={frontmatter.website} target="_blank" class="text-indigo-600 dark:text-indigo-400 hover:underline font-medium">Link</a>
            </div>
            <div class="flex flex-col items-center p-4 bg-zinc-50 dark:bg-zinc-800 rounded-xl min-w-[120px]">
                <span class="text-xs uppercase tracking-wider font-semibold text-zinc-500 dark:text-zinc-400 mb-1">GitHub</span>
                <a href={frontmatter.github} target="_blank" class="text-indigo-600 dark:text-indigo-400 hover:underline font-medium">Repo</a>
            </div>
        </div>

        <div class="prose prose-lg dark:prose-invert mx-auto max-w-none">
            <slot />
        </div>
    </article>
</Layout>
