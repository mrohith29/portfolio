---
import Layout from "./Layout.astro";
const { frontmatter, readingTime } = Astro.props;
const fmt = (d: Date | string) =>
  new Date(d).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---
<Layout
  pageTitle={`${frontmatter.title} — Rohith Mariyala`}
  description={frontmatter.description}
  image={frontmatter.image?.url}
  type="article"
>
  <article class="post container-t">
    <a href="/blog/" class="back">← cd ../writing</a>

    <header class="post-head">
      <div class="post-meta">
        <time datetime={new Date(frontmatter.pubDate).toISOString()}>{fmt(frontmatter.pubDate)}</time>
        {readingTime && <><span class="sep">·</span><span>{readingTime}</span></>}
        <span class="sep">·</span><span>{frontmatter.author}</span>
      </div>
      <h1 class="post-title">{frontmatter.title}</h1>
      {frontmatter.description && <p class="post-lede">{frontmatter.description}</p>}
    </header>

    {frontmatter.image?.url && (
      <img class="post-hero" src={frontmatter.image.url} alt={frontmatter.image.alt} loading="lazy" />
    )}

    <div class="prose-t post-body">
      <slot />
    </div>

    {frontmatter.tags?.length > 0 && (
      <div class="post-tags">
        {frontmatter.tags.map((t: string) => <span class="chip">#{t}</span>)}
      </div>
    )}

    <footer class="post-foot">
      <a href="/blog/" class="link">← all posts</a>
    </footer>
  </article>
</Layout>

<style>
  .post { max-width: 720px; }
  .back { display: inline-block; font-size: 0.82rem; color: var(--muted); margin-bottom: 1.6rem; }
  .back:hover { color: var(--accent); }
  .post-head { margin-bottom: 1.8rem; }
  .post-meta { display: flex; align-items: center; gap: 0.6rem; font-size: 0.78rem; color: var(--muted); flex-wrap: wrap; margin-bottom: 0.9rem; }
  .post-meta .sep { color: var(--faint); }
  .post-title { font-size: clamp(1.9rem, 5vw, 2.8rem); color: var(--fg); line-height: 1.12; }
  .post-lede { color: var(--fg-soft); font-size: 1.08rem; margin-top: 0.9rem; max-width: 62ch; }
  .post-hero { width: 100%; border-radius: 12px; border: 1px solid var(--line); margin-bottom: 2.2rem; }
  .post-body { margin-bottom: 2.5rem; }
  .post-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; padding-top: 1.4rem; border-top: 1px solid var(--line); margin-bottom: 1.4rem; }
  .post-foot { padding-top: 0.4rem; }
</style>
